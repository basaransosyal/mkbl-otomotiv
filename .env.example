# MKBL Otomotiv Website - Production Environment Variables Configuration

# Node Environment
NODE_ENV=production

# Application Port
PORT=3000

# Next.js Public Site Base URL
NEXT_PUBLIC_SITE_URL=https://mkbloto.com

# Database URL (SQLite default or PostgreSQL / MySQL)
# For SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/mkbl_db?schema=public"

# Admin Authentication Secret Token (Optional Session Hash Salt)
NEXTAUTH_SECRET=your-super-secret-random-hash-key-change-this-in-production
