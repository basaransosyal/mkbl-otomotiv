datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Vehicle {
  id              String   @id @default(uuid())
  name            String
  tagline         String
  category        String   // City, Cargo, Sport, Cross
  price           Float
  rangeKm         Int
  topSpeed        Int
  chargeTime      String
  battery         String
  licenseType     String
  motorPower      String
  dimensions      String   @default("2.631 mm x 1.498 mm x 1.621 mm")
  chargePower     String   @default("3,3 kW/s Ev Tipi 220V")
  capacityDetails String   @default("3 Kapı / 2 Koltuk / 184 L")
  rimSize         String   @default("13 inç Alaşım Jant")
  images          String   // JSON Array string
  colors          String   // JSON Array string
  features        String   // JSON Array string
  stockStatus     String   @default("STOKTA") // STOKTA, ÖN SİPARİŞ, TÜKENDİ
  isPublished     Boolean  @default(true)
  showOnHomepage  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TestDriveRequest {
  id            String   @id @default(uuid())
  fullName      String
  phone         String
  email         String
  city          String
  vehicleId     String?
  vehicleName   String
  preferredDate String
  preferredTime String
  status        String   @default("BEKLEMEDE") // BEKLEMEDE, ARANDI, TAMAMLANDI, İPTAL
  notes         String?
  createdAt     DateTime @default(now())
}

model ServiceAppointment {
  id              String   @id @default(uuid())
  fullName        String
  phone           String
  email           String
  licensePlate    String
  vehicleModel    String
  serviceType     String
  appointmentDate String
  appointmentTime String
  status          String   @default("BEKLEMEDE") // BEKLEMEDE, ONAYLANDI, TAMAMLANDI, İPTAL
  userNotes       String?
  createdAt       DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  phone     String
  email     String
  subject   String
  message   String
  status    String   @default("BEKLEMEDE") // BEKLEMEDE, OKUNDU, YANITLANDI, İPTAL
  createdAt DateTime @default(now())
}

