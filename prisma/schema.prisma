model CustomPage {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  path            String
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  content         String?
  isPublished     Boolean  @default(true)
  isIndexable     Boolean  @default(true)
  pageType        String   @default("SİSTEM") // SİSTEM, MODEL, ÖZEL
  cmsTabTarget    String?  // homepage, showroom, service, contact, legal, tracking, vehicles
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminUser {
  id          String   @id @default(uuid())
  username    String   @unique
  fullName    String
  email       String?
  password    String   // Hashed or encrypted password string
  role        String   @default("YÖNETİCİ") // SÜPER ADMİN, YÖNETİCİ, EDİTÖR, SATIŞ, MÜŞTERİ İLİŞKİLERİ, SSH
  title       String?  @default("Yönetici") // Ünvan (örn: Satış Danışmanı, SSH Yöneticisi, Müşteri İlişkileri Temsilcisi)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GallerySlide {
  id          String   @id @default(uuid())
  vehicleId   String?  @default("karea-fit")
  title       String
  subtitle    String?
  description String?
  tagText     String?  @default("Karea Özel Donanım")
  imageUrl    String
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



